# ---------------------------------------------------------------------------
# Pro-AI / Director-AI — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for the providers you use.
# Never commit your real `.env` to git.
# ---------------------------------------------------------------------------

# --- Vision / LLM backends (first non-empty wins) --------------------------
#
# Priority order for vision:
#   1. Anthropic  (ClaudeVisionTool      — claude-sonnet-4-6)
#   2. OpenAI     (OpenAIVisionTool      — gpt-4o)
#   3. Google     (GeminiVisionTool      — gemini-1.5-pro)
#   4. none       (NullVisionInterface)

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI GPT-4o
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (same key is reused for Google Custom Search below)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Default Model
DEFAULT_MODEL=openai

# --- Web search backends (first non-empty wins) ----------------------------
#
# Priority order for web:
#   1. Google Custom Search  (GOOGLE_API_KEY + GOOGLE_CSE_ID)
#   2. Brave Search          (BRAVE_API_KEY)
#   3. DuckDuckGo            (no key required)

# Google Programmable Search Engine — CSE ID required alongside GOOGLE_API_KEY.
# https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=

# Brave Search API — https://api.search.brave.com/
BRAVE_API_KEY=

# --- Server runtime --------------------------------------------------------

DAI_HOST=0.0.0.0
DAI_PORT=8000
DAI_UPLOAD_DIR=uploads
DAI_MAX_UPLOAD_BYTES=10485760

API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# --- Memory Configuration --------------------------------------------------

MEMORY_FILE=data/memory.json
MAX_MEMORY_ENTRIES=1000
