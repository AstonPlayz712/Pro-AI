{
  "perplexity": {
    "kind": "http",
    "endpoint": "https://api.perplexity.ai/chat/completions",
    "auth": "Bearer ${PERPLEXITY_API_KEY}",
    "default_model": "sonar-pro",
    "timeout": 60,
    "request_shape": {
      "model": "<model id>",
      "messages": [
        {"role": "system", "content": "<system prompt>"},
        {"role": "user", "content": "<task>"}
      ],
      "temperature": 0.2,
      "max_tokens": 2048
    },
    "notes": "Primary execution engine for DAI. Every reasoning call funnels here via core.perplexity_query()."
  },
  "claude_desktop": {
    "kind": "http",
    "endpoint": "http://127.0.0.1:7060/v1/messages",
    "auth": "none (localhost shim)",
    "default_model": "claude-sonnet-4-6",
    "timeout": 60,
    "request_shape": {
      "model": "<model id>",
      "system": "<system prompt>",
      "messages": [{"role": "user", "content": "<task>"}]
    },
    "notes": "Expects a local proxy bridging Claude Desktop to an HTTP endpoint. Configure the port to match your shim."
  },
  "copilot": {
    "kind": "cli",
    "command": "gh copilot suggest -t shell {task}",
    "timeout": 120,
    "notes": "Runs the GitHub Copilot CLI. Replace the command template if you prefer 'gh copilot explain' or a Copilot Chat shim."
  },
  "slack": {
    "kind": "external_connector",
    "connector_id": "slack_direct",
    "action": "post_message",
    "auth": "external_connector",
    "request_shape": {
      "channel": "<from subai.slack_channel>",
      "text": "<task>"
    },
    "notes": "Routed through the host's Slack external connector. No bot token required."
  },
  "monday": {
    "kind": "external_connector",
    "connector_id": "monday",
    "action": "create_item",
    "auth": "external_connector",
    "request_shape": {
      "board_id": "<from subai.monday_board>",
      "item_name": "DAI: <task>"
    },
    "notes": "Routed through the host's Monday external connector. No API key required."
  },
  "asana": {
    "kind": "external_connector",
    "connector_id": "asana_mcp_merge",
    "action": "create_task",
    "auth": "external_connector",
    "request_shape": {
      "project": "<from subai.asana_project>",
      "name": "DAI: <task>",
      "notes": "<task>"
    },
    "notes": "Routed through the host's Asana external connector. No PAT required."
  }
}
